generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id        String   @id
  snapshot  Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model User {
  id          String   @id @default(cuid())
  displayName String
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
}
